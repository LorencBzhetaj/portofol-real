---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import Arrow from '../components/Arrow.astro';
import ServiceCard from '../components/ServiceCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import { galleries, localize, projectBySlug, projectPanel, serviceBySlug, ui, type Lang } from '../lib/site';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = ui[lang];
const p = projectBySlug(slug, lang);
const panel = projectPanel(slug, lang);
const img = p.featuredImage;
const relatedServices = p.relatedServiceSlugs.map((s) => serviceBySlug(s, lang));

// Gallery only with files that exist; dimensions read from the generated manifest.
const variants = JSON.parse(fs.readFileSync(path.resolve('src/data/image-variants.json'), 'utf8'));
const gallery = (galleries[slug] ?? []).filter((g) => variants[g.path]).map((g) => ({ path: g.path, alt: g.alt[lang], ...variants[g.path] }));
const external = p.externalUrlConfirmed ? p.externalUrl : null;
const externalHost = external ? new URL(external).host.replace(/^www\./, '') : null;
---
<Base sqPath={'/projektet/' + slug} lang={lang}>
  <Breadcrumbs lang={lang} items={[{ label: t.home, href: localize('/', lang) }, { label: t.projects, href: localize('/projektet', lang) }, { label: p.name }]} />

  <section class="section proj-head">
    <div class="wrap head-grid">
      <div>
        <p class="category">{panel.category}</p>
        <h1>{p.h1}</h1>
        <p class="lede">{p.intro}</p>
        <ul class="tags">
          {panel.tags.map((tag) => <li class="tag">{tag}</li>)}
          {p.visibleStatusLabel && <li class="tag tag--status">{p.visibleStatusLabel}</li>}
        </ul>
      </div>
      {external && (
        <div class="head-actions">
          <a class="btn" href={external} target="_blank" rel="noopener">{t.visitSite} <Arrow /><span class="sr-only">{t.newWindow}</span></a>
          <span class="host">{externalHost}</span>
        </div>
      )}
    </div>
  </section>

  <section class="feature" aria-label={t.mainView}>
    <figure class="wrap">
      <!-- Composition shown whole: width 100%, height auto, no crop. -->
      <div class="feature-media card">
        <Picture src={img.path} alt={img.alt} width={img.width} height={img.height} sizes="(max-width: 1240px) 96vw, 1200px" priority />
      </div>
      {p.visibleImageNotice && <figcaption>{p.visibleImageNotice}</figcaption>}
    </figure>
  </section>

  <section class="section--tight">
    <div class="wrap story">
      <div class="block">
        <h2>{t.need}</h2>
        <p>{p.context}</p>
      </div>
      <div class="block">
        <h2>{t.solution}</h2>
        <p>{p.solution}</p>
      </div>
      <div class="block card features">
        <h2>{t.features}</h2>
        <ul class="check-list">{p.features.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="section--tight" aria-labelledby="galeria">
      <div class="wrap">
        <h2 id="galeria" class="sec-title">{t.gallery}</h2>
        <ul class="gallery">
          {gallery.map((g) => (
            <li class="card">
              <Picture src={g.path} alt={g.alt} width={g.width} height={g.height} sizes="(max-width: 760px) 92vw, 580px" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section--tight" aria-labelledby="sherbime-lidhura">
    <div class="wrap">
      <h2 id="sherbime-lidhura" class="sec-title">{t.relatedServices}</h2>
      <div class="grid-3">{relatedServices.map((s) => <ServiceCard service={s} lang={lang} />)}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap end-cta">
      <h2>{t.similarTitle}</h2>
      <p>{t.similarBody}</p>
      <div class="btn-row">
        <a class="btn btn--light" href={p.cta.href}>{p.cta.label} <Arrow /></a>
        {external && <a class="btn btn--ghost on-dark" href={external} target="_blank" rel="noopener">{t.visitSite} <Arrow /><span class="sr-only">{t.newWindow}</span></a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .proj-head { padding-top: 32px; padding-bottom: 36px; }
  .head-grid { display: flex; justify-content: space-between; align-items: end; gap: 28px; flex-wrap: wrap; }
  .category { margin: 0 0 12px; color: var(--accent); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 18px 0 0; }
  .head-actions { display: grid; justify-items: start; gap: 8px; }
  .host { color: var(--muted); font-size: 0.9rem; }
  .feature figure { margin: 0 auto; }
  .feature-media { overflow: hidden; background: var(--ivory-2); }
  .feature-media :global(img) { width: 100%; height: auto; }
  figcaption { margin-top: 12px; color: var(--muted); font-size: 0.92rem; }

  .story { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 28px 40px; align-items: start; }
  .block h2 { font-size: 1.35rem; margin-bottom: 12px; }
  .block p { margin: 0; color: var(--ink-2); }
  .features { padding: 26px; box-shadow: none; }

  .sec-title { margin-bottom: 26px; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .gallery { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .gallery li { overflow: hidden; box-shadow: none; }
  .gallery :global(img) { width: 100%; height: auto; }

  .end-cta { padding: clamp(28px, 5vw, 56px); border-radius: 28px; background: var(--ink); color: var(--ivory-2); display: grid; justify-items: center; text-align: center; gap: 12px; }
  .end-cta h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .end-cta p { margin: 0 0 10px; color: #d8d2c7; }
  .end-cta .btn-row { justify-content: center; }
  .on-dark { color: var(--ivory-2); border-color: var(--ivory-2); }
  .on-dark:hover { background: var(--ivory-2); color: var(--ink); }

  @media (max-width: 900px) { .story { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .gallery { grid-template-columns: 1fr; } }
</style>
