---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getContent, localize, ui, type Lang } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const p = getContent(lang).privacy;
---
<Base sqPath="/privatesia" lang={lang}>
  <Breadcrumbs lang={lang} items={[{ label: t.home, href: localize('/', lang) }, { label: t.privacy }]} />
  <article class="section privacy">
    <div class="wrap narrow">
      <h1>{p.h1}</h1>
      {p.draftOnly && (
        <p class="draft" role="note"><strong>{t.draftTitle}</strong> {p.intro} {t.draftNote}</p>
      )}
      {p.sections.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          <p>{s.body}</p>
        </section>
      ))}
    </div>
  </article>
</Base>
<style>
  .privacy { padding-top: 32px; }
  h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); margin-bottom: 24px; }
  .draft { padding: 16px 18px; border: 1.5px dashed var(--accent); border-radius: 14px; background: var(--ivory-2); color: var(--ink-2); }
  section { margin-top: 32px; }
  h2 { font-size: 1.3rem; margin-bottom: 10px; }
  section p { color: var(--ink-2); }
</style>
