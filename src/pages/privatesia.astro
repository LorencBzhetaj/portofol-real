---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { content } from '../lib/site';

const p = content.privacy;
---
<Base routePath={p.path}>
  <Breadcrumbs items={[{ label: 'Kreu', href: '/' }, { label: 'Privatësia' }]} />
  <article class="section privacy">
    <div class="wrap narrow">
      <h1>{p.h1}</h1>
      {p.draftOnly && (
        <p class="draft" role="note"><strong>Draft i brendshëm.</strong> {p.intro} Fushat në kllapa katrore duhen plotësuar me të dhëna reale para publikimit.</p>
      )}
      {p.sections.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          <p>{s.body}</p>
        </section>
      ))}
    </div>
  </article>
</Base>
<style>
  .privacy { padding-top: 32px; }
  h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); margin-bottom: 24px; }
  .draft { padding: 16px 18px; border: 1.5px dashed var(--accent); border-radius: 14px; background: var(--ivory-2); color: var(--ink-2); }
  section { margin-top: 32px; }
  h2 { font-size: 1.3rem; margin-bottom: 10px; }
  section p { color: var(--ink-2); }
</style>
