---
import Base from '../../layouts/Base.astro';
import content from '../../data/content.sq.json';
import routes from '../../data/routes.seo.json';

const sherbimet = (content as any).hubs.find((h: any) => h.path === '/sherbimet');
const routeMeta = (routes as any[]).find((r: any) => r.path === '/sherbimet');
const services = (content as any).services as any[];
---
<Base
  title={routeMeta.title}
  description={routeMeta.description}
  robots="noindex,nofollow"
  ogImage={routeMeta.featuredImage.ogPath}
  ogImageAlt={routeMeta.featuredImage.ogAlt}
  ogImageWidth={routeMeta.featuredImage.ogWidth}
  ogImageHeight={routeMeta.featuredImage.ogHeight}
>
  <div class="container">
    <div class="page-header">
      <h1>{routeMeta.h1}</h1>
      <p>{sherbimet.intro}</p>
    </div>
    <div class="grid-3">
      {services.map((s: any) => (
        <a href={`/sherbimet/${s.slug}`} class="card" style="text-decoration:none">
          {s.featuredImage && (
            <div class="card-image">
              <img
                src={s.featuredImage.path}
                alt={s.featuredImage.alt}
                width={s.featuredImage.width}
                height={s.featuredImage.height}
                loading="lazy"
              />
            </div>
          )}
          <h3>{s.name}</h3>
          <p>{s.intro}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
