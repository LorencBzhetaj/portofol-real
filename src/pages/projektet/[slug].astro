---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import content from '../../data/content.sq.json';
import routes from '../../data/routes.seo.json';

export function getStaticPaths() {
  const slugs = [
    'thethi-guide',
    'gjecaj-guesthouse-restaurant',
    'gjecaj-rezervime',
    'baby-gifts-albania',
    'aleks-bzhetaj',
    'mb-cartongesso',
    'gjecaj-menu-online',
  ];
  return slugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = ((content as any).projects as any[]).find((p: any) => p.slug === slug);
const routeMeta = (routes as any[]).find((r: any) => r.path === `/projektet/${slug}`);

if (!project || !routeMeta) {
  return Astro.redirect('/projektet');
}

const relatedServices = ((content as any).services as any[]).filter((s: any) =>
  (project.relatedServiceSlugs || []).includes(s.slug)
);
---
<Base
  title={routeMeta.title}
  description={routeMeta.description}
  robots="noindex,nofollow"
  ogImage={routeMeta.featuredImage?.ogPath}
  ogImageAlt={routeMeta.featuredImage?.ogAlt}
  ogImageWidth={routeMeta.featuredImage?.ogWidth}
  ogImageHeight={routeMeta.featuredImage?.ogHeight}
>
  <div class="container">
    <Breadcrumb items={[
      { label: 'Kreu', href: '/' },
      { label: 'Projektet', href: '/projektet' },
      { label: project.name },
    ]} />

    <div class="page-header">
      {project.visibleStatusLabel && (
        <span class="status-label">{project.visibleStatusLabel}</span>
      )}
      <h1>{project.name}</h1>
      {project.intro && <p>{project.intro}</p>}
    </div>

    <img
      src={project.featuredImage.path}
      alt={project.featuredImage.alt}
      width={project.featuredImage.width}
      height={project.featuredImage.height}
      class="feature-image"
    />

    {project.visibleImageNotice && (
      <p style="font-size:13px; color:var(--muted); margin-bottom:2rem">{project.visibleImageNotice}</p>
    )}

    <div class="service-content">
      {project.context && (
        <div class="service-section">
          <h2>Nevoja</h2>
          <p>{project.context}</p>
        </div>
      )}

      {project.solution && (
        <div class="service-section">
          <h2>Zgjidhja</h2>
          <p>{project.solution}</p>
        </div>
      )}

      {project.features && (project.features as string[]).length > 0 && (
        <div class="service-section">
          <h2>Çfarë u ndërtua</h2>
          <ul class="service-list">
            {(project.features as string[]).map((f: string) => (
              <li>{f}</li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {relatedServices.length > 0 && (
      <div class="related-section">
        <h2 class="section-heading">Shërbime të lidhura</h2>
        <div class="grid-3">
          {relatedServices.map((s: any) => (
            <a href={`/sherbimet/${s.slug}`} class="card" style="text-decoration:none">
              <h3>{s.name}</h3>
              <p>{s.intro}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="related-section" style="display:flex; gap:1rem; flex-wrap:wrap; align-items:center">
      {project.externalUrl && project.externalUrlConfirmed && (
        <a href={project.externalUrl} class="btn btn-secondary" target="_blank" rel="noopener">Vizito faqen</a>
      )}
      <a href="/kontakt" class="btn btn-primary">Fillo një projekt</a>
    </div>
  </div>
</Base>
