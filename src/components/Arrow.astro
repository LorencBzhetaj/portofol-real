---
interface Props { dir?: 'up-right' | 'right' }
const { dir = 'up-right' } = Astro.props;
---
<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  {dir === 'up-right'
    ? <path d="M5 11L11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    : <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
</svg>
