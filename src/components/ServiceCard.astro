---
import Picture from './Picture.astro';
import Arrow from './Arrow.astro';
import cards from '../data/cards.json';
import { ui, type Lang, type Service } from '../lib/site';

interface Props { service: Service; lang: Lang; headingLevel?: 'h2' | 'h3' }
const { service: s, lang, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const t = ui[lang];
// Status labels come from the package cards (keyed by the Albanian path).
const card = cards.find((c) => c.href === '/sherbimet/' + s.slug);
const label = card?.visibleStatusLabel ? (lang === 'sq' ? card.visibleStatusLabel : t.concept) : null;
const img = s.featuredImage;
---
<article class="card service-card">
  <div class="media">
    <Picture src={img.path} alt={img.alt} width={img.width} height={img.height} sizes="(max-width: 680px) 92vw, (max-width: 1020px) 46vw, 380px" />
    {label && <span class="tag tag--status badge">{label}</span>}
  </div>
  <div class="body">
    <H class="title"><a href={s.path}>{s.name}</a></H>
    <p>{s.intro}</p>
    <span class="more" aria-hidden="true">{t.seeService} <Arrow dir="right" /></span>
  </div>
</article>
<style>
  .service-card { display: flex; flex-direction: column; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; }
  .service-card:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgb(17 17 17 / 5%), 0 22px 40px -22px rgb(17 17 17 / 30%); }
  .media { position: relative; aspect-ratio: 16 / 10; background: var(--sand); }
  .media :global(picture) { height: 100%; }
  .media :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .badge { position: absolute; left: 14px; top: 14px; background: var(--ivory-2); }
  .body { display: flex; flex-direction: column; gap: 8px; padding: 18px 22px 22px; flex: 1; }
  .title { font-size: 1.2rem; }
  .title a { text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .title a:focus-visible { outline: none; }
  .service-card:has(.title a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .more { margin-top: auto; padding-top: 6px; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.93rem; }
  .more :global(.arrow) { width: 16px; height: 16px; }
  @media (prefers-reduced-motion: reduce) { .service-card:hover { transform: none; } }
</style>
