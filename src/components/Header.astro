---
import Arrow from './Arrow.astro';
import { getContent, localize, ui, type Lang } from '../lib/site';

interface Props { lang: Lang; sqPath?: string }
const { lang, sqPath } = Astro.props;
const t = ui[lang];
const L = (p: string) => localize(p, lang);
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const services = getContent(lang).services;
const otherLang: Lang = lang === 'sq' ? 'en' : 'sq';
const switchHref = sqPath ? localize(sqPath, otherLang) : otherLang === 'en' ? '/en' : '/';
const isCurrent = (href: string) => current === href || current.startsWith(href + '/');
const servicesHub = L('/sherbimet');
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={L('/')} aria-label={t.brandHome}>
      <img src="/images/brand/lb-studio-lockup.svg" alt="LB STUDIO" width="356" height="100" />
    </a>
    <div class="bar-end">
      <a class="lang lang--bar" href={switchHref} hreflang={otherLang} lang={otherLang} aria-label={t.switchLabel}>{t.switchShort}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">{t.menu}</span>
        <span class="burger" aria-hidden="true"><span></span></span>
      </button>
    </div>
    <nav id="site-nav" class="nav" aria-label={t.navMain}>
      <ul class="top">
        <li><a href={L('/projektet')} aria-current={isCurrent(L('/projektet')) ? 'page' : undefined}>{t.projects}</a></li>
        <li class="has-sub">
          <div class="sub-head">
            <a href={servicesHub} aria-current={current === servicesHub ? 'page' : undefined}>{t.services}</a>
            <button class="sub-toggle" type="button" aria-expanded="false" aria-controls="services-sub">
              <span class="sr-only">{t.servicesSubmenu}</span>
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          </div>
          <ul id="services-sub" class="sub">
            {services.map((s) => (
              <li><a href={s.path} aria-current={current === s.path ? 'page' : undefined}>{s.name}</a></li>
            ))}
            <li class="sub-all"><a href={servicesHub}>{t.allServices} <Arrow dir="right" /></a></li>
          </ul>
        </li>
        <li><a href={L('/#si-punojme')}>{t.howWeWork}</a></li>
        <li class="lang-item"><a class="lang" href={switchHref} hreflang={otherLang} lang={otherLang} aria-label={t.switchLabel}>{t.switchShort}</a></li>
        <li class="cta"><a class="btn" href={L('/kontakt')} aria-current={current === L('/kontakt') ? 'page' : undefined}>{t.contact} <Arrow /></a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const subToggle = document.querySelector<HTMLButtonElement>('.sub-toggle');
  const subItem = subToggle?.closest<HTMLElement>('.has-sub');
  const setSub = (open: boolean) => {
    subToggle?.setAttribute('aria-expanded', String(open));
    subItem?.classList.toggle('open', open);
  };
  subToggle?.addEventListener('click', () => setSub(subToggle.getAttribute('aria-expanded') !== 'true'));
  // Desktop: close the submenu when focus or pointer leaves it.
  subItem?.addEventListener('focusout', (e) => {
    if (!subItem.contains(e.relatedTarget as Node) && !nav?.classList.contains('open')) setSub(false);
  });
  document.addEventListener('click', (e) => {
    if (subItem && !subItem.contains(e.target as Node) && !nav?.classList.contains('open')) setSub(false);
  });

  if (toggle && nav) {
    const mq = window.matchMedia('(max-width: 900px)');
    const setOpen = (open: boolean, focusToggle = false) => {
      const bottom = toggle.closest('header')?.getBoundingClientRect().bottom ?? 76;
      nav.style.setProperty('--header-bottom', `${Math.round(bottom)}px`);
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
      document.body.classList.toggle('nav-open', open);
      if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
      else { setSub(false); if (focusToggle) toggle.focus(); }
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (nav.classList.contains('open')) setOpen(false, true);
      else if (subItem?.classList.contains('open')) { setSub(false); subToggle?.focus(); }
    });
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    // Keep keyboard focus inside the open mobile menu (toggle + focusable items).
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !nav.classList.contains('open')) return;
      const items = [...nav.querySelectorAll<HTMLElement>('a, button')].filter((el) => el.offsetParent !== null);
      const first = items[0];
      const last = items[items.length - 1];
      if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); toggle.focus(); }
      else if (e.shiftKey && document.activeElement === toggle) { e.preventDefault(); last.focus(); }
      else if (e.shiftKey && document.activeElement === first) { e.preventDefault(); toggle.focus(); }
    });
    mq.addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; }
  /* Blur lives on a pseudo-element: backdrop-filter on the header itself would
     become the containing block of the fixed mobile menu. */
  .site-header::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: rgb(247 243 236 / 92%);
    backdrop-filter: saturate(1.4) blur(10px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 76px; }
  .brand { display: block; flex: none; }
  .brand img { width: 150px; height: auto; }
  .bar-end { display: none; }
  .top { display: flex; align-items: center; gap: 30px; margin: 0; padding: 0; list-style: none; }
  .top > li > a:not(.btn):not(.lang), .sub-head > a { font-size: 0.97rem; font-weight: 500; text-decoration: none; padding: 6px 0; border-bottom: 1.5px solid transparent; }
  .top > li > a:not(.btn):not(.lang):hover, .top a[aria-current='page']:not(.btn), .sub-head > a:hover { border-bottom-color: currentColor; }
  .cta .btn { min-height: 44px; padding: 10px 22px; }
  .lang {
    display: inline-grid; place-items: center; min-width: 44px; height: 40px; padding: 0 10px;
    border: 1px solid var(--line); border-radius: 999px; background: var(--ivory-2);
    font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; text-decoration: none;
  }
  .lang:hover { border-color: var(--ink); }

  /* Services submenu */
  .has-sub { position: relative; }
  .sub-head { display: flex; align-items: center; gap: 2px; }
  .sub-toggle { display: inline-grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; }
  .sub-toggle svg { width: 12px; height: 12px; transition: transform 0.2s; }
  .has-sub.open .sub-toggle svg { transform: rotate(180deg); }
  .sub {
    display: none; position: absolute; left: -18px; top: calc(100% + 10px); z-index: 10;
    min-width: 290px; margin: 0; padding: 10px; list-style: none;
    border: 1px solid var(--line); border-radius: 18px; background: var(--ivory-2); box-shadow: var(--shadow);
  }
  .sub::before { content: ''; position: absolute; left: 0; right: 0; top: -12px; height: 12px; }
  .has-sub.open .sub { display: block; }
  @media (hover: hover) and (min-width: 901px) { .has-sub:hover .sub { display: block; } }
  .sub a { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 12px; border-radius: 10px; text-decoration: none; font-size: 0.95rem; }
  .sub a:hover, .sub a[aria-current='page'] { background: var(--sand); }
  .sub-all { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line); }
  .sub-all a { font-weight: 600; }
  .sub-all :global(.arrow) { width: 14px; height: 14px; }

  @media (max-width: 900px) {
    .brand img { width: 132px; }
    .bar-end { display: flex; align-items: center; gap: 10px; }
    .lang-item { display: none; }
    .menu-toggle {
      display: inline-grid; place-items: center; width: 48px; height: 48px;
      border: 1px solid var(--line); border-radius: 50%; background: var(--ivory-2); color: var(--ink); cursor: pointer;
    }
    .burger, .burger::before, .burger::after, .burger span { display: block; width: 20px; height: 2px; border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
    .burger span, .burger::before, .burger::after { background: currentColor; }
    .burger { position: relative; }
    .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
    .burger::before { top: -6px; }
    .burger::after { top: 6px; }
    [aria-expanded='true'] .burger span { opacity: 0; }
    [aria-expanded='true'] .burger::before { transform: translateY(6px) rotate(45deg); }
    [aria-expanded='true'] .burger::after { transform: translateY(-6px) rotate(-45deg); }

    .nav {
      display: none;
      position: fixed; left: 0; right: 0; bottom: 0; top: var(--header-bottom, 76px);
      background: var(--ivory);
      padding: 8px var(--gutter) 40px;
      overflow-y: auto;
    }
    .nav.open { display: block; }
    .top { flex-direction: column; align-items: stretch; gap: 0; }
    .top > li > a:not(.btn):not(.lang), .sub-head > a { display: block; flex: 1; padding: 16px 0; font-size: 1.45rem; font-weight: 600; letter-spacing: -0.02em; border-bottom: 0; }
    .top > li:not(.cta):not(.lang-item) { border-bottom: 1px solid var(--line); }
    .top a[aria-current='page']:not(.btn) { text-decoration: underline; text-underline-offset: 6px; }
    .sub-toggle { width: 48px; height: 48px; border: 1px solid var(--line); background: var(--ivory-2); }
    .sub-toggle svg { width: 14px; height: 14px; }
    .sub { position: static; min-width: 0; margin: 0 0 14px; padding: 6px; box-shadow: none; }
    .sub::before { display: none; }
    .sub a { padding: 11px 12px; font-size: 1rem; }
    .cta { margin-top: 24px; }
    .cta .btn { width: 100%; min-height: 54px; font-size: 1.05rem; }
  }
  :global(body.nav-open) { overflow: hidden; }
</style>
