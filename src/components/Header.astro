---
---
<header class="site-header">
  <a href="/" class="header-brand" aria-label="LB STUDIO kryefaqe">LB STUDIO</a>
  <button class="hamburger" id="hamburger" aria-label="Hap navigimin" aria-expanded="false" aria-controls="site-nav">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
  <nav aria-label="Navigim kryesor">
    <ul class="site-nav" id="site-nav">
      <li><a href="/projektet">Projektet</a></li>
      <li><a href="/sherbimet">Shërbimet</a></li>
      <li><a href="/#si-punojme">Si punojmë</a></li>
      <li><a href="/kontakt">Kontakt</a></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('hamburger');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
