---
---
<section class="contact-form-section">
  <h2>Dërgo një kërkesë</h2>
  <form id="kerkese-projekti" novalidate>
    <fieldset disabled>
      <div class="form-group">
        <label for="emri">Emri <span aria-hidden="true">*</span></label>
        <input type="text" id="emri" name="emri" autocomplete="name" required />
      </div>
      <div class="form-group">
        <label for="email">Email <span aria-hidden="true">*</span></label>
        <input type="email" id="email" name="email" autocomplete="email" required />
      </div>
      <div class="form-group">
        <label for="mesazhi">Mesazhi <span aria-hidden="true">*</span></label>
        <textarea id="mesazhi" name="mesazhi" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Dërgo kërkesën</button>
    </fieldset>
  </form>
  <p class="form-note">Formulari është i çaktivizuar gjatë staging.</p>
</section>
