---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { seoFor, production, formEndpoint, ui, type Lang } from '../lib/site';

interface Props {
  /** Albanian path of the page (the content package key); omitted for the 404 page. */
  sqPath?: string;
  lang?: Lang;
}
const { sqPath, lang = 'sq' } = Astro.props;
const t = ui[lang];
const head = sqPath
  ? seoFor(sqPath, lang)
  : { title: `${t.notFoundTitle.replace(/\.$/, '')} | LB STUDIO`, description: t.notFoundBody, robots: 'noindex,follow', headHtml: null };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {head.headHtml ? (
      <Fragment set:html={head.headHtml} />
    ) : (
      <>
        <title>{head.title}</title>
        <meta name="description" content={head.description} />
        <meta name="robots" content={head.robots} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f3ec" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    {!production && (
      <div class="staging-note" role="note">{t.staging}{formEndpoint ? '.' : t.stagingNoForm}</div>
    )}
    <Header lang={lang} sqPath={sqPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
<style>
  .staging-note { padding: 7px var(--gutter); background: var(--ink); color: var(--ivory-2); font-size: 0.8rem; text-align: center; line-height: 1.4; }
  main:focus { outline: none; }
</style>
