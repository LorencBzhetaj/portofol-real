---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { seoFor, production, formEndpoint } from '../lib/site';

interface Props { routePath?: string }
const { routePath } = Astro.props;
const head = routePath
  ? seoFor(routePath)
  : { title: 'Faqja nuk u gjet | LB STUDIO', description: 'Faqja që kërkon nuk ekziston.', robots: 'noindex,follow', headHtml: null };
---
<!doctype html>
<html lang="sq">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {head.headHtml ? (
      <Fragment set:html={head.headHtml} />
    ) : (
      <>
        <title>{head.title}</title>
        <meta name="description" content={head.description} />
        <meta name="robots" content={head.robots} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f3ec" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Kalo te përmbajtja</a>
    {!production && (
      <div class="staging-note" role="note">Version prove (staging) — jo për publikim. Faqet janë noindex{formEndpoint ? "." : " dhe formulari nuk dërgon ende."}</div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style>
  .staging-note { padding: 7px var(--gutter); background: var(--ink); color: var(--ivory-2); font-size: 0.8rem; text-align: center; line-height: 1.4; }
  main:focus { outline: none; }
</style>
