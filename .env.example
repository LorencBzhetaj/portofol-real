# Leave empty until the final domain is confirmed (lbstudio.com / lbstudio.al?).
# When set, pages get canonical, og:url, og:image and JSON-LD for this origin.
SITE_URL=
# Only "true" after site-config.json is complete (contact, privacy, form delivery, approvals).
# The build fails on purpose while the production guards are not satisfied.
PRODUCTION=
# Form endpoint (server-side). Empty = sending disabled, no simulated success.
PUBLIC_FORM_ENDPOINT=
